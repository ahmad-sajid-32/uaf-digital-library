# ===============================
# UAF Smart E-Library Backend
# Environment Configuration
# ===============================

# ---------------------------------
# Application Environment
# ---------------------------------
# Must be one of: local | staging | production
ENVIRONMENT=local

# ---------------------------------
# Logging Configuration
# ---------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------
# PostgreSQL Connection (Supavisor)
# ---------------------------------
# Format:
# postgresql://<user>:<password>@<host>:6543/<database>
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<PROJECT_REF>.supabase.co:6543/postgres

# ---------------------------------
# Supabase Project
# ---------------------------------
# Example format:
# https://ykqrdavopwzeoyysnggn.supabase.co
SUPABASE_PROJECT_URL=https://<PROJECT_REF>.supabase.co

# ---------------------------------
# Supabase JWT Audience
# ---------------------------------
# Must be exactly: authenticated
SUPABASE_JWT_AUDIENCE=authenticated

# ---------------------------------
# Supabase Service Role Key (BACKEND ONLY)
# ---------------------------------
# ⚠ HIGHLY SENSITIVE
# This key bypasses RLS and allows admin user creation.
# Never expose to frontend.
# Never commit real value to Git.
# Obtain from:
# Supabase Dashboard → Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here