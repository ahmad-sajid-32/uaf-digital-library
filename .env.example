# UAF Smart E-Library monorepo environment reference
# Use the app-level example files for real local setup:
# - apps/api/.env.example
# - apps/web/.env.example

# Frontend
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<PROJECT_REF>.supabase.co:6543/postgres
SUPABASE_PROJECT_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
