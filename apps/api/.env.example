# UAF Smart E-Library Backend
# Local development example configuration

# Application environment: local | staging | production
ENVIRONMENT=local

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supavisor pooled PostgreSQL connection string
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@<PROJECT_REF>.supabase.co:6543/postgres

# Supabase project URL
SUPABASE_PROJECT_URL=https://<PROJECT_REF>.supabase.co

# Frontend application base URL used in auth recovery emails
FRONTEND_APP_URL=http://localhost:3000

# CORS origin policy
# Local example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Preview / staging example:
# CORS_ALLOWED_ORIGINS=https://preview.example.com
# Production example:
# CORS_ALLOWED_ORIGINS=https://library.uaf.edu.pk
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# Shared security controls
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
TRUSTED_CLIENT_IP_HEADERS=
AUTH_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_PUBLIC_RATE_LIMIT_MAX_REQUESTS=12
ADMIN_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_AUTH_RATE_LIMIT_MAX_REQUESTS=40
BOOK_PUBLIC_DETAIL_RATE_LIMIT_WINDOW_SECONDS=60
BOOK_PUBLIC_DETAIL_RATE_LIMIT_MAX_REQUESTS=60
BOOK_QUEUE_READ_RATE_LIMIT_WINDOW_SECONDS=60
BOOK_QUEUE_READ_RATE_LIMIT_MAX_REQUESTS=30
BOOK_STAFF_READ_RATE_LIMIT_WINDOW_SECONDS=60
BOOK_STAFF_READ_RATE_LIMIT_MAX_REQUESTS=60
BOOK_MUTATION_RATE_LIMIT_WINDOW_SECONDS=300
BOOK_MUTATION_RATE_LIMIT_MAX_REQUESTS=20
CIRCULATION_READ_RATE_LIMIT_WINDOW_SECONDS=60
CIRCULATION_READ_RATE_LIMIT_MAX_REQUESTS=60
CIRCULATION_MUTATION_RATE_LIMIT_WINDOW_SECONDS=300
CIRCULATION_MUTATION_RATE_LIMIT_MAX_REQUESTS=20
FINE_READ_RATE_LIMIT_WINDOW_SECONDS=60
FINE_READ_RATE_LIMIT_MAX_REQUESTS=30
FINE_SETTLEMENT_RATE_LIMIT_WINDOW_SECONDS=300
FINE_SETTLEMENT_RATE_LIMIT_MAX_REQUESTS=15
AI_CONVERSATION_READ_RATE_LIMIT_WINDOW_SECONDS=60
AI_CONVERSATION_READ_RATE_LIMIT_MAX_REQUESTS=60
AI_CONVERSATION_WRITE_RATE_LIMIT_WINDOW_SECONDS=300
AI_CONVERSATION_WRITE_RATE_LIMIT_MAX_REQUESTS=20
AI_RETRIEVAL_RATE_LIMIT_WINDOW_SECONDS=60
AI_RETRIEVAL_RATE_LIMIT_MAX_REQUESTS=20
AI_GENERATION_RATE_LIMIT_WINDOW_SECONDS=60
AI_GENERATION_RATE_LIMIT_MAX_REQUESTS=10
DOCUMENT_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300
DOCUMENT_UPLOAD_RATE_LIMIT_MAX_REQUESTS=20
DOCUMENT_FINALIZE_RATE_LIMIT_WINDOW_SECONDS=300
DOCUMENT_FINALIZE_RATE_LIMIT_MAX_REQUESTS=15
DOCUMENT_READ_RATE_LIMIT_WINDOW_SECONDS=300
DOCUMENT_READ_RATE_LIMIT_MAX_REQUESTS=60
DOCUMENT_DELETE_RATE_LIMIT_WINDOW_SECONDS=300
DOCUMENT_DELETE_RATE_LIMIT_MAX_REQUESTS=15
DOCUMENT_UPLOAD_MAX_FILE_SIZE_BYTES=26214400
DOCUMENT_SIGNED_READ_URL_TTL_SECONDS=300
DOCUMENT_UPLOAD_STALE_AFTER_SECONDS=86400

# Expected JWT audience
SUPABASE_JWT_AUDIENCE=authenticated

# Backend-only privileged key. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET_UNIVERSITY_DOCUMENTS=university-documents

# Bytez embeddings
BYTEZ_API_KEY=your_bytez_api_key_here
BYTEZ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCUMENT_EMBEDDING_DIMENSIONS=384
DOCUMENT_CHUNK_SIZE=1400
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_RETRIEVAL_DEFAULT_TOP_K=5
DOCUMENT_RETRIEVAL_MAX_TOP_K=12
DOCUMENT_RETRIEVAL_SIMILARITY_THRESHOLD=0.70
BYTEZ_CHAT_MODEL=Qwen/Qwen3-4B-Instruct-2507
BYTEZ_CHAT_TEMPERATURE=0.1
BYTEZ_CHAT_MAX_TOKENS=500

# UAF LMS result scraper settings
LMS_RESULT_URL=https://lms.uaf.edu.pk/login/index.php
SELENIUM_TIMEOUT_SECONDS=45
REG_INPUT_SELECTOR=id=REG
SUBMIT_SELECTOR=xpath=//input[@type='submit'][@value='Result']
